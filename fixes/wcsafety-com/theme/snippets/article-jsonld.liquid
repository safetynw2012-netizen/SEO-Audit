{%- comment -%}
  article-jsonld
  ---------------------------------------------------------------------------
  Emits Article (+ optional Review) JSON-LD for blog articles. Pulls reviewer
  identity from the editorial.reviewer metafield (same one the methodology
  callout uses) and rating from the review.rating metafield when present.

  Install: include in <head> of layout/theme.liquid, gated by page type:

      {% if request.page_type == 'article' %}
        {% render 'article-jsonld' %}
      {% endif %}

  Article metafield definitions required (Settings → Custom data → Articles):

    namespace: editorial · key: reviewer        · type: single_line_text_field
    namespace: editorial · key: last_reviewed   · type: date
    namespace: review    · key: rating          · type: number_decimal
    namespace: review    · key: product_name    · type: single_line_text_field

  Behavior:
    - Article schema is always emitted on article pages.
    - Review schema is emitted only when review.rating is populated.
    - Author falls back to article.author and then to a generic editorial-team
      string if neither metafield nor article.author is set — but a real
      named reviewer is the high-impact E-E-A-T setting.

  Validate after install:
    https://validator.schema.org/
    https://search.google.com/test/rich-results
{%- endcomment -%}

{%- if article -%}
  {%- assign reviewer_name = article.metafields.editorial.reviewer.value
                          | default: article.author
                          | default: 'WC Safety Editorial Team' -%}
  {%- assign last_modified_raw = article.metafields.editorial.last_reviewed.value
                              | default: article.published_at -%}
  {%- assign rating_value = article.metafields.review.rating.value -%}
  {%- assign reviewed_product = article.metafields.review.product_name.value
                              | default: article.title -%}
  {%- assign article_image = article.image | image_url: width: 1200 -%}

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Article",
        "@id": "{{ shop.url }}{{ article.url }}#article",
        "headline": {{ article.title | strip_html | json }},
        {%- if article_image %}
        "image": ["{{ article_image | prepend: 'https:' }}"],
        {%- endif %}
        "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
        "dateModified": {{ last_modified_raw | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
        "author": {
          "@type": "Person",
          "name": {{ reviewer_name | json }}
        },
        "publisher": {
          "@type": "Organization",
          "name": {{ shop.name | json }},
          "url": {{ shop.url | json }},
          "logo": {
            "@type": "ImageObject",
            "url": "{{ 'logo.png' | asset_url | prepend: 'https:' }}"
          }
        },
        "mainEntityOfPage": {
          "@type": "WebPage",
          "@id": "{{ shop.url }}{{ article.url }}"
        },
        "description": {{ article.summary | default: article.excerpt | strip_html | json }}
      }
      {%- if rating_value -%}
      ,
      {
        "@type": "Review",
        "@id": "{{ shop.url }}{{ article.url }}#review",
        "itemReviewed": {
          "@type": "Product",
          "name": {{ reviewed_product | json }}
        },
        "reviewRating": {
          "@type": "Rating",
          "ratingValue": {{ rating_value | json }},
          "bestRating": "5",
          "worstRating": "1"
        },
        "author": {
          "@type": "Person",
          "name": {{ reviewer_name | json }}
        },
        "publisher": {
          "@type": "Organization",
          "name": {{ shop.name | json }}
        },
        "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }}
      }
      {%- endif -%}
    ]
  }
  </script>
{%- endif -%}
